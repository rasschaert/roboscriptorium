# From PDF to EPUB: the stages, in the order `pipeline.run` runs them, and the
# model (or plain code, or a person) each one uses.
# Render: d2 docs/pipeline.d2 docs/pipeline.svg

direction: down

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 30
  }
}

classes: {
  stage: {
    shape: rectangle
    style: {fill: "#ffffff"; stroke: "#3b4252"; border-radius: 6; font-size: 15}
  }
  row: {
    label: ""
    grid-rows: 1
    horizontal-gap: 30
    style: {fill: transparent; stroke: transparent}
  }
  code: {
    shape: hexagon
    style: {fill: "#eceff4"; stroke: "#4c566a"; font-size: 13}
  }
  ollama: {
    shape: oval
    style: {fill: "#fde8d0"; stroke: "#c2671b"; font-size: 13}
  }
  decision: {
    shape: oval
    style: {fill: "#dbe9f7"; stroke: "#2e6db4"; font-size: 13}
  }
  vision: {
    shape: oval
    style: {fill: "#e3f2dc"; stroke: "#3f7f2f"; font-size: 13}
  }
  human: {
    shape: person
    style: {fill: "#f6e3f0"; stroke: "#9b3d7f"; font-size: 13}
  }
  candidate: {
    shape: oval
    style: {fill: "#ffffff"; stroke: "#c2671b"; stroke-dash: 4; font-size: 13}
  }
  file: {
    shape: document
    style: {fill: "#fff8db"; stroke: "#8a6d00"; font-size: 15; bold: true}
  }
  uses: {style: {stroke: "#9a9a9a"; stroke-dash: 3; font-size: 12}}
  group: {
    grid-columns: 1
    vertical-gap: 70
    style: {fill: "#f7f9fc"; stroke: "#7b8aa6"; font-size: 20; bold: true}
  }
}

# source.pdf, three kinds, left to right by what the file already holds of the printed page.
digital: "born-digital PDF\nthe text is the page;\nthe picture only renders it" {class: file}
layered: "scan with a text layer\nthe picture is the page; over it, invisible,\none machine's reading of it" {class: file}
bare: "image-only scan\nthe picture is the page,\nand nothing has read it" {class: file}

read: 1 · Read the page {
  class: group
  s: {
    class: row
    layer: First reading\nvisual lines with boxes {class: stage}
    regions: Layout regions\nfigures, captions, titles {class: stage}
    missing: Missing lines\nprinted lines the first reading lacks {class: stage}
    type: Type style\nsize, weight, capitals {class: stage}
    layer -> regions -> missing -> type
  }
  m: {
    class: row
    yolo: "SPOTTER DocLayout-YOLO" {class: vision}
    glm: "READER glm-ocr:bf16\nreads the region" {class: ollama}
    ink: "measures each line's type size, stroke\nand letter width from its ink" {class: code}
  }
  s.regions -> m.yolo {class: uses}
  s.missing -> m.glm {class: uses}
  s.type -> m.ink {class: uses}
}

understand: 2 · What each line is {
  class: group
  s: {
    class: row
    roles: Line roles\nbody, heading, page number,\nrunning head, artefact {class: stage}
  }
  m: {
    class: row
    pick: rules pick\nthe doubtful lines {class: code}
    flash: SORTER clef-flash:9b\ndecides each one {class: decision}
    fix: rules and a style vote\ncorrect it {class: code}
    tree: SORTER trees trained on golden books\nredecide every line {class: candidate}
    pick -> flash -> fix -> tree
  }
  s.roles -> m.pick {class: uses}
}

check: 3 · Check the OCR (scans only) {
  class: group
  s: {
    class: row
    horizontal-gap: 160
    second: More readings\nof each body line\n(washed-out pages skipped) {class: stage}
    judge: Judges\npick a version of each suspect {class: stage}
    trust: Arbiter\nfix, keep, or ask {class: stage}
    second -> judge -> trust
  }
  m: {
    class: row
    glm: "READER glm-ocr:bf16" {class: ollama}
    tess: "READER tesseract\n(the book's language)" {class: code}
    qwen: "READER qwen3.8:27b-nvfp4,\ntold the book's style" {class: ollama}
    clef: "JUDGE clef:27b\nfrom the crop" {class: decision}
    winnow: "JUDGE winnow-ollama:e4b\nfrom the sentence" {class: decision}
    words: "JUDGE the word list" {class: code}
    gbt: "ARBITER trees trained\non golden books" {class: code}
  }
  s.second -> m.glm {class: uses}
  s.second -> m.tess {class: uses}
  s.second -> m.qwen {class: uses}
  s.judge -> m.clef {class: uses}
  s.judge -> m.winnow {class: uses}
  s.judge -> m.words {class: uses}
  s.trust -> m.gbt {class: uses}
}

review: 4 · Review {
  class: group
  s: {
    class: row
    flags: Questions\nOCR doubts per place, headings,\nfigures, unpaired quotes,\nwashed-out pages {class: stage}
    page: Review page\nthe scan crop beside each question {class: stage}
    answers: Answers\nregions.jsonl {class: stage}
    flags -> page -> answers
  }
  m: {
    class: row
    qread: "READER qwen3.8:27b-nvfp4\nproposes an unpaired quote's marks" {class: ollama}
    init: "SORTER clef-flash:9b\nguesses a drawn initial's letter" {class: decision}
    faint: "contrast between paper\nand ink (scans only)" {class: code}
    you: REVIEWER, you {class: human}
    slip: answer check: a typed line\nmust match a reading {class: code}
    proof: qwen3.8 proofreads\nthe answers {class: candidate}
  }
  s.flags -> m.qread {class: uses}
  s.flags -> m.init {class: uses}
  s.flags -> m.faint {class: uses}
  s.page -> m.you: a key per answer {class: uses}
  s.page -> m.slip: before saving {class: uses}
  s.answers -> m.proof {class: uses}
}

build: 5 · Assemble the book {
  class: group
  s: {
    class: row
    reflow: Reflow\nparagraphs, line-end hyphens {class: stage}
    italics: Italics {class: stage}
    dash: Typography\none dash and ellipsis style per book {class: stage}
    figures: Figures\npictures and captions {class: stage}
    reflow -> italics -> dash -> figures
  }
  m: {
    class: row
    spell: the book's own spellings {class: code}
    words: the word list\n(which form it knows) {class: code}
    slant: stroke slant per word {class: code}
    gap: "dash length and gaps, ellipsis form\n(or book.toml), measured first,\ndashes told to the readers" {class: code}
    regions: "the SPOTTER's pictures;\nthe REVIEWER's turns" {class: code}
  }
  s.reflow -> m.spell {class: uses}
  s.reflow -> m.words {class: uses}
  s.italics -> m.slant {class: uses}
  s.dash -> m.gap {class: uses}
  s.figures -> m.regions {class: uses}
}

epub: book.epub\nEPUB 3, checked by epubcheck {class: file}

digital -> read: PyMuPDF extracts\nthe text, exact
layered -> read: PyMuPDF reads the\nlayer's words out
bare -> read: READER tesseract\nreads the picture
read -> understand: lines
understand -> check: lines with roles
check -> review: undecided places
review -> build: answers, on the next build
check -> build: fixes applied {style.stroke-dash: 0}
understand -> build: born-digital: its text\nis exact, no check
build -> epub

legend: Who does the work {
  class: group
  grid-columns: 7
  horizontal-gap: 30
  r: "A WORD IN CAPITALS is a role, a job\nhow-it-works.md explains; after it,\nwho holds the job today" {class: stage}
  v: vision model\n(not an LLM) {class: vision}
  g: generative model\n(Ollama) {class: ollama}
  d: "decision model\n(Ollama systemone)" {class: decision}
  c: plain code {class: code}
  h: a person {class: human}
  p: candidate,\nnot wired in yet {class: candidate}
}
epub -> legend {style.opacity: 0}
